{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QQ Bot Notifier: uvicorn",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "7848",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/env/bin/python",
      "windows": {
        "python": "${workspaceFolder}/env/Scripts/python.exe"
      },
      "osx": {
        "python": "${workspaceFolder}/env/bin/python"
      },
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
