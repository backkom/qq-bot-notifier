# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，不要提交到仓库。
#
# SnowLuma / NapCat 等 OneBot 实现的 HTTP access token。
# 设置后会覆盖 config/config.json 里的 qq_bot.token。
QQ_BOT_TOKEN=

# 可选：覆盖默认路径。
# QQ_NOTIFIER_CONFIG=config/config.json
# QQ_DELIVERY_LOG=logs/qqbot-payloads.jsonl
# QQ_RECEIVED_MESSAGES=logs/received-messages.json
